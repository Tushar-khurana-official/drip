# Copy to .env for local use. On Vercel set these in Project → Settings → Environment Variables.
# Never commit real values: .env is git-ignored.

# --- Login (required) ---
APP_EMAIL=""
APP_PASSWORD=""
# Signs login sessions. A long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=""

# --- WhatsApp API (Meta Cloud API format, through the provider's gateway) ---
WHATSAPP_API_BASE="https://crmapi.setu360.com/api/meta/v19.0"
# Sent as "Authorization: Bearer <token>". Keep it secret.
WHATSAPP_TOKEN=""
# The sending number. Messages go to POST {base}/{WHATSAPP_PHONE_NUMBER_ID}/messages
WHATSAPP_PHONE_NUMBER_ID=""
# WhatsApp Business Account ID. Templates come from GET {base}/{WHATSAPP_WABA_ID}/message_templates?json=true
WHATSAPP_WABA_ID=""

# --- Database (required on Vercel, optional locally) ---
# Postgres connection string (e.g. Neon). Without it data goes to ./data/drip.json.
DATABASE_URL=""

# --- Scheduler on Vercel ---
# Protects GET /api/cron/send-due (call every minute with "Authorization: Bearer <CRON_SECRET>").
# Not needed with `npm start` / `npm run dev`: the Node server sends due messages every 30 seconds.
CRON_SECRET=""

# --- Front end hosted on another site (GitHub Pages) ---
# Browser origins allowed to call this API (comma-separated).
ALLOWED_ORIGINS="https://itsasoeternity.github.io"

# PORT=3000
